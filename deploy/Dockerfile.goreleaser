# GoReleaser 用精简镜像：单一二进制（前端+配置已嵌入）
# 构建上下文仅包含 linmo 二进制

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata

# 二进制（已包含前端与 linmo.json.example）
COPY linmo /usr/local/bin/linmo

# 首次启动时 config.Load 会将嵌入的 linmo.json.example 写入 ~/.linmo/
ENV LIMNO_STATE_DIR=/root/.linmo

EXPOSE 18900

ENTRYPOINT ["linmo"]
CMD ["gateway", "run", "--port", "18900"]
