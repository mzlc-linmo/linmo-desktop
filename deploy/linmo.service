# Linmo Gateway systemd 服务
# 适用于 amd64 / arm64，安装到 /lib/systemd/system/ 后执行:
#   sudo systemctl daemon-reload
#   sudo systemctl enable linmo
#   sudo systemctl start linmo

[Unit]
Description=Linmo Gateway
Documentation=https://docs.openclaw.ai/gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -lic "exec /usr/bin/linmo gateway run --port 18900"
Restart=on-failure
RestartSec=5
# 明确运行形态：Linux 下以 service 形式对外提供访问
Environment=LIMNO_RUN_MODE=service
# 状态目录（可按需覆盖）
Environment=LIMNO_STATE_DIR=/root/.linmo
# 建议以专用用户运行（按需取消注释并创建用户）
# User=linmo
# Group=linmo

[Install]
WantedBy=multi-user.target
